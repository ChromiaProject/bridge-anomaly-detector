            <!-- EIF contracts -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <classifier>sources</classifier>
                            <includeArtifactIds>postchain-eif-contracts</includeArtifactIds>
                            <includeTypes>tar.gz</includeTypes>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.web3j</groupId>
                <artifactId>web3j-maven-plugin</artifactId>
                <version>${web3j.version}</version>
                <configuration>
                    <packageName>net.postchain.eif.contracts</packageName>
                    <nativeJavaType>false</nativeJavaType>
                    <contract>
                        <includes>
                            <include>TokenBridge</include>
                                                        <include>TestToken</include>
                                                        <include>Validator</include>
                            <!--                            <include>Anchoring</include>-->
                            <!--                            <include>DirectoryChainValidator</include>-->
                            <!--                            <include>ManagedValidator</include>-->
                        </includes>
                    </contract>
<!--                    <pathPrefixes>-->
<!--                        <pathPrefix>@openzeppelin=../node_modules/@openzeppelin</pathPrefix>-->
<!--                    </pathPrefixes>-->
                    <abiSourceFiles>
                        <directory>${project.build.directory}/postchain-eif-contracts/abi</directory>
                        <includes>
                            <include>**/TokenBridge.json</include>
                                                        <include>**/TestToken.json</include>
                                                        <include>**/Validator.json</include>
                            <!--                            <include>**/Anchoring.json</include>-->
                            <!--                            <include>**/DirectoryChainValidator.json</include>-->
                            <!--                            <include>**/ManagedValidator.json</include>-->
                        </includes>
                    </abiSourceFiles>
                    <outputDirectory>
                        <abi>${project.basedir}/target/generated-resources</abi>
                        <java>${project.basedir}/target/generated-sources</java>
                    </outputDirectory>
                    <outputFormat>java,abi</outputFormat>
                </configuration>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-sources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>target/generated-sources</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-resource</id>
                        <phase>generate-resources</phase>
