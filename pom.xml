        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>3.3.2</version>
                    <configuration>
                        <allowInsecureRegistries>false</allowInsecureRegistries>
                        <from>
                            <image>registry.gitlab.com/chromaway/core-tools/chromia-images/java21:1.0.1@sha256:def7ecec42cdc4545be824e539bc5802f89a3eff618b9194a6c02e2d28910f4a</image>
                        </from>
                        <container>
                            <entrypoint>
                                <args>/usr/bin/pmc</args>
                            </entrypoint>
                            <appRoot>/opt/chromaway/postchain</appRoot>
                            <workingDirectory>/opt/chromaway/postchain</workingDirectory>
                            <mainClass>${main-class}</mainClass>
                            <creationTime>${git.commit.time}</creationTime>
                            <filesModificationTime>${git.commit.time}</filesModificationTime>
                        </container>
                        <extraDirectories>
                            <permissions>
                                <permission>
                                    <file>/usr/bin/pmc</file>
                                    <mode>755</mode>
                                </permission>
                            </permissions>
                        </extraDirectories>
                        <containerizingMode>packaged</containerizingMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>docker-build</id>
                            <phase>package</phase>
                            <goals>
                                <goal>dockerBuild</goal>
                            </goals>
                            <configuration>
                                <to>
                                    <image>${image.name}</image>
                                </to>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <configuration>
                        <prettyPrint>true</prettyPrint>
                        <failBuildOnAnyVulnerability>true</failBuildOnAnyVulnerability>
                        <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                        <yarnAuditAnalyzerEnabled>false</yarnAuditAnalyzerEnabled>
                        <suppressionFiles>
                            <suppressionFile>https://gitlab.com/chromaway/chromia-parent/-/raw/dev/common-dependencies-suppression.xml?ref_type=heads</suppressionFile>
                            <suppressionFile>dependencies-suppression.xml</suppressionFile>
                        </suppressionFiles>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>ci</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-plugin</artifactId>
                        <configuration>
