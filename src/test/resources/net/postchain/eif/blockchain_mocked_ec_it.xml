                        </array>
                    </entry>
                    <entry key="sources">
                        <dict>
                            <entry key="economy_chain/module.rell">
                                <string>module;
                                </string>
                            </entry>
                            <entry key="economy_chain/economy_chain_model.rell">
                                <string>
entity bridge_lease {
    key blockchain_rid: byte_array, evm_network_id: integer;
    mutable bridge_contract: text;
    mutable anomaly_detection: boolean = true;
}
struct bridge_anomaly_detector_data {
    blockchain_rid: byte_array;
    evm_network_id: integer;
    bridge_contract: text;
}
</string>
                            </entry>
                            <entry key="economy_chain/economy_chain_queries.rell">
                                <string>
query get_blockchains_with_bridge_and_anomaly_detection() = bridge_lease @* { .anomaly_detection } (
    bridge_anomaly_detector_data(
    blockchain_rid = .blockchain_rid,
    evm_network_id = .evm_network_id,
    bridge_contract = .bridge_contract
    )
);
operation add_anomaly_detection(blockchain_rid: byte_array, evm_network_id: integer, bridge_contract: text) {
    create bridge_lease(
        .blockchain_rid = blockchain_rid,
        .evm_network_id = evm_network_id,
        .bridge_contract = bridge_contract
    );
}
operation remove_anomaly_detection(blockchain_rid: byte_array) {
    delete bridge_lease @* { blockchain_rid };
}
</string>
                            </entry>
                        </dict>
                    </entry>
